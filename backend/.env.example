# Copiez ce fichier en ".env" et remplissez les valeurs. Ne commitez JAMAIS le vrai .env.
PORT=3000
NODE_ENV=development            # mettez "production" sur Render

DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/mangassouba

# Deux secrets DIFFÉRENTS, aléatoires, de 64 caractères ou plus.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_CLIENT_SECRET=

# Domaines autorisés à appeler l'API (séparés par des virgules). Obligatoire en production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optionnel
# BCRYPT_ROUNDS=12
# TRUST_PROXY=1
# DB_SSL=true
# DB_SSL_STRICT=false
